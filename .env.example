# ---------------------------------------------------------------------------
# NIGHTCELL 7 — environment contract.
# Every service validates its own slice of this at boot and refuses to start
# with missing secrets in production (PRD §17.6).
# ---------------------------------------------------------------------------

NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:8080

# --- gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
SITE_UPSTREAM=http://localhost:3000
GAME_UPSTREAM=http://localhost:5173
API_UPSTREAM=http://localhost:3001
MULTIPLAYER_UPSTREAM=http://localhost:3002
MAINTENANCE_MODE=false

# --- api -------------------------------------------------------------------
API_PORT=3001
AUTH_SECRET=dev-only-change-me-0000000000000000000000000000
TICKET_SECRET=dev-only-change-me-1111111111111111111111111111
TICKET_TTL_SECONDS=45

# --- multiplayer -----------------------------------------------------------
MULTIPLAYER_PORT=3002
MULTIPLAYER_REGION=us-west
MULTIPLAYER_SHARD=1
MULTIPLAYER_MAX_ROOMS=20

# --- worker ----------------------------------------------------------------
WORKER_PORT=3003

# --- shared infrastructure -------------------------------------------------
REDIS_URL=redis://localhost:6379
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# --- CoinPayPortal (sole payment integration, PRD §24) ---------------------
COINPAY_API_BASE=https://api.coinpayportal.com
COINPAY_API_KEY=
COINPAY_WEBHOOK_SECRET=

# --- Resend ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="NIGHTCELL 7 <no-reply@nightcell7.com>"

# --- Cloudflare R2 ---------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nightcell7-content
