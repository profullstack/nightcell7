{
  "name": "@nightcell7/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NIGHTCELL 7 desktop client",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "start": "pnpm build && electron-forge start",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "electron": "^33.3.1",
    "typescript": "^5.7.2",
    "@electron-forge/shared-types": "^7.6.0"
  }
}
