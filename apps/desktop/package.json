{
  "name": "@nightcell7/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NIGHTCELL 7: FALSE DAWN \u2014 premium episodic first-person shooter.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "start": "pnpm build && electron dist/main.js",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "typescript": "^5.7.2",
    "electron-builder": "^25.1.8"
  },
  "author": {
    "name": "Profullstack, Inc.",
    "email": "support@nightcell7.com"
  },
  "homepage": "https://nightcell7.com",
  "license": "UNLICENSED"
}
