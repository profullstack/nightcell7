<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron requires JIT and unsigned executable memory for V8. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The game loads nightcell7.com, so outbound network is required. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Deliberately NOT requested: microphone, camera, location, contacts.
         The game needs none of them (PRD §33.6). -->
  </dict>
</plist>
