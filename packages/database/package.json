{
  "name": "@nightcell7/database",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --rootDir src --outDir dist",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "@types/pg": "^8.23.1"
  }
}
