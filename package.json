{
  "name": "nightcell7",
  "version": "0.5.4",
  "private": true,
  "description": "NIGHTCELL 7: FALSE DAWN — single repository for marketing site, game, PWA, desktop, API, multiplayer, workers and infrastructure.",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "tools/multiplayer-loadtest"
  ],
  "trustedDependencies": [
    "esbuild",
    "@tailwindcss/oxide",
    "sharp",
    "electron",
    "better-sqlite3"
  ],
  "scripts": {
    "dev": "bun tools/release/dev.mjs",
    "dev:deps": "docker compose -f infra/local/docker-compose.yml up -d",
    "dev:deps:down": "docker compose -f infra/local/docker-compose.yml down",
    "build": "bun run --filter \"./packages/**\" build && bun run --filter \"./services/**\" build && bun run --filter \"./apps/**\" build",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "db:generate": "bun run --filter @nightcell7/database generate",
    "db:migrate": "bun run --filter @nightcell7/database migrate",
    "loadtest": "bun run --filter @nightcell7/tools-multiplayer-loadtest start",
    "assets:build": "bun tools/art/build-assets.mjs",
    "assets:capture": "bun run --filter @nightcell7/game build && bun tools/art/capture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
