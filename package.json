{
  "name": "nightcell7",
  "version": "0.1.0",
  "private": true,
  "description": "NIGHTCELL 7: FALSE DAWN \u2014 single repository for marketing site, game, PWA, desktop, API, multiplayer, workers and infrastructure.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/release/dev.mjs",
    "dev:deps": "docker compose -f infra/local/docker-compose.yml up -d",
    "dev:deps:down": "docker compose -f infra/local/docker-compose.yml down",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./services/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @nightcell7/database generate",
    "db:migrate": "pnpm --filter @nightcell7/database migrate",
    "loadtest": "pnpm --filter @nightcell7/tools-multiplayer-loadtest start",
    "assets:build": "node tools/art/build-assets.mjs",
    "assets:capture": "pnpm --filter @nightcell7/game build && node tools/art/capture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "electron",
      "better-sqlite3"
    ]
  }
}
