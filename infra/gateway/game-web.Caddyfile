# Static asset server for the game build. Private to the Railway network; the
# public gateway is the only thing that talks to it.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Content-hashed assets are immutable and safe to cache hard.
	@hashed path_regexp \.[a-f0-9]{8,}\.(js|css|ktx2|glb|webm|woff2)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# The shell itself must revalidate so an update is actually picked up.
	@shell path /play/ /play/index.html /play/sw.js /play/manifest.webmanifest
	header @shell Cache-Control "no-cache"

	header X-Content-Type-Options "nosniff"

	handle /health/live {
		respond "{\"status\":\"ok\",\"service\":\"game-web\"}" 200
	}
	handle /health/ready {
		respond "{\"status\":\"ok\",\"service\":\"game-web\"}" 200
	}

	try_files {path} /play/index.html
	file_server
}
